# Posta Chiara — configurazione
#
# Questo file documenta TUTTE le variabili d'ambiente del progetto.
# Nessuna di esse e' obbligatoria: clonando il repository ed eseguendo
# `uvicorn app.backend.main:app --port 8123` tutto funziona con i default.
#
# ATTENZIONE: non esiste una variabile ANTHROPIC_API_KEY.
# Il progetto non contiene codice di rete e non chiama alcuna API. Vedi README.

# off    = solo motore deterministico a regole (default)
# replay = attraversa la seam LLM leggendo le fixture in app/fixtures/llm/
LLM_MODE=off

# "Oggi" iniettabile: rende deterministiche le scadenze del corpus e i test.
# Formato ISO. Se assente, vale la costante in app/backend/clock.py
POSTA_CHIARA_OGGI=2026-10-06
